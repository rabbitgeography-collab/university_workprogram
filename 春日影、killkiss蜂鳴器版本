// ==================================================
// STATES
// ==================================================

enum Mood {
  NORMAL,
  SOUND_HAPPY,
  BUTTON_HAPPY,
  LONELY
};

enum MelodyType {
  NO_MELODY,
  MELODY_SOUND,
  MELODY_BUTTON
};

Mood mood = NORMAL;
MelodyType activeMelody = NO_MELODY;

unsigned long startupTime;
unsigned long lastInteractionTime;
unsigned long lastSoundTime = 0;
unsigned long lastDebounceTime = 0;
unsigned long lastColorChangeTime = 0;

int lastButtonReading = HIGH;
int stableButtonState = HIGH;
int lonelyColorIndex = 0;

bool soundArmed = false;
bool stepActive = false;
bool noteEnded = false;

int noteIndex = 0;
unsigned long noteStartTime = 0;
unsigned long noteDuration = 0;
unsigned long noteGap = 0;

// ==================================================
// SETUP
// ==================================================

void setup() {
  pinMode(RED_PIN, OUTPUT);
  pinMode(GREEN_PIN, OUTPUT);
  pinMode(BLUE_PIN, OUTPUT);

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(SOUND_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  Serial.begin(9600);

  startupTime = millis();
  lastInteractionTime = startupTime;

  setRGB(true, true, false);

  Serial.println("Emotion Doll Ready");
  Serial.print("BMP180 notes: ");
  Serial.println(COUNT1);
  Serial.print("BMP=100 notes: ");
  Serial.println(COUNT2);
  Serial.println("Waiting for sound or button.");
}

// ==================================================
// MAIN LOOP
// ==================================================

void loop() {
  unsigned long now = millis();

  readButton(now);
  readSound(now);
  updateMelody(now);
  updateMood(now);
  updateRGB(now);
}

// ==================================================
// BUTTON: PLAY MELODY 2
// Button has priority and interrupts current playback.
// ==================================================

void readButton(unsigned long now) {
  int reading = digitalRead(BUTTON_PIN);

  if (reading != lastButtonReading) {
    lastDebounceTime = now;
  }

  if (now - lastDebounceTime >= DEBOUNCE_TIME) {
    if (reading != stableButtonState) {
      stableButtonState = reading;

      if (stableButtonState == LOW) {
        Serial.println("[BUTTON] 一生、バンドしてくれる？");
        Serial.println("[MELODY] BMP=100");
        startMelody(MELODY_BUTTON, now);
      }
    }
  }

  lastButtonReading = reading;
}

// ==================================================
// SOUND SENSOR: PLAY MELODY 1
// ==================================================

void readSound(unsigned long now) {
  int soundState = digitalRead(SOUND_PIN);

  if (now - startupTime < STARTUP_TIME) {
    return;
  }

  // Ignore the sensor during either melody.
  if (activeMelody != NO_MELODY) {
    return;
  }

  // Rearm only when the sensor returns to inactive.
  if (soundState != SOUND_ACTIVE_LEVEL) {
    soundArmed = true;
    return;
  }

  if (soundArmed &&
      now - lastSoundTime >= SOUND_COOLDOWN) {

    soundArmed = false;
    lastSoundTime = now;

    Serial.println("[SOUND] Sound detected!");
    Serial.println("[MELODY] BMP180");
    startMelody(MELODY_SOUND, now);
  }
}

// ==================================================
// START MELODY
// ==================================================

void startMelody(MelodyType type, unsigned long now) {
  activeMelody = type;
  noteIndex = 0;
  stepActive = false;
  noteEnded = false;

  noTone(BUZZER_PIN);

  lastInteractionTime = now;

  if (type == MELODY_BUTTON) {
    mood = BUTTON_HAPPY;
  } else {
    mood = SOUND_HAPPY;
  }
}

// ==================================================
// MELODY PLAYER
// Non-blocking: no delay().
// ==================================================

void updateMelody(unsigned long now) {
  if (activeMelody == NO_MELODY) {
    return;
  }

  int count = (activeMelody == MELODY_SOUND)
              ? COUNT1 : COUNT2;

  if (noteIndex >= count) {
    noTone(BUZZER_PIN);
    activeMelody = NO_MELODY;
    stepActive = false;

    Serial.println("[MELODY] Playback finished.");
    return;
  }

  if (!stepActive) {
    uint16_t frequency;
    
    if (activeMelody == MELODY_SOUND) {
      frequency = melody1[noteIndex];
      noteDuration = 1000UL / duration1[noteIndex];
    } else {
      frequency = melody2[noteIndex];
      noteDuration = duration2[noteIndex];
    }

    // Short separation between notes.
    noteGap = 20;

    noteStartTime = now;
    stepActive = true;
    noteEnded = false;

    if (frequency == 0) {
      noTone(BUZZER_PIN);
    } else {
      tone(BUZZER_PIN, frequency);
    }

    return;
  }

  unsigned long elapsed = now - noteStartTime;

  if (!noteEnded && elapsed >= noteDuration) {
    noTone(BUZZER_PIN);
    noteEnded = true;
  }

  if (elapsed >= noteDuration + noteGap) {
    stepActive = false;
    noteIndex++;
  }
}

// ==================================================
// MOOD TIMER
// ==================================================

void updateMood(unsigned long now) {
  if (activeMelody != NO_MELODY) {
    return;
  }

  if (now - lastInteractionTime >= LONELY_TIMEOUT) {
    if (mood != LONELY) {
      mood = LONELY;
      Serial.println("[MOOD] Waiting for you...");
    }
  } else if (mood == SOUND_HAPPY ||
             mood == BUTTON_HAPPY) {
    mood = NORMAL;
  }
}

// ==================================================
// RGB LED
// LOW = ON
// ==================================================

void setRGB(bool redOn, bool greenOn, bool blueOn) {
  digitalWrite(RED_PIN, redOn ? LOW : HIGH);
  digitalWrite(GREEN_PIN, greenOn ? LOW : HIGH);
  digitalWrite(BLUE_PIN, blueOn ? LOW : HIGH);
}

void updateRGB(unsigned long now) {
  switch (mood) {
    case NORMAL:
      setRGB(true, true, false);       // Yellow
      break;

    case SOUND_HAPPY:
      setRGB(false, true, false);      // Green
      break;

    case BUTTON_HAPPY:
      setRGB(true, false, true);       // Purple
      break;

    case LONELY:
      if (now - lastColorChangeTime >= COLOR_INTERVAL) {
        lastColorChangeTime = now;
        lonelyColorIndex = (lonelyColorIndex + 1) % 4;
      }

      switch (lonelyColorIndex) {
        case 0: setRGB(false, false, true); break; // Blue
        case 1: setRGB(true, false, true); break;  // Purple
        case 2: setRGB(false, false, true); break; // Blue
        case 3: setRGB(true, false, false); break; // Red
      }
      break;
  }
}
