/*
  Emotion Doll: Two Melodies + Interactive RGB

  Sound sensor D2 -> BMP180 melody
  Button D4       -> BMP=100 melody
  Passive buzzer  -> D9
  RGB LED         -> D6, D7, D8 (LOW = ON)

  Serial Monitor: 9600 baud
*/

#include <Arduino.h>

const int RED_PIN = 6;
const int GREEN_PIN = 7;
const int BLUE_PIN = 8;
const int BUTTON_PIN = 4;
const int SOUND_PIN = 2;
const int BUZZER_PIN = 9;

const int SOUND_ACTIVE_LEVEL = LOW;

const unsigned long LONELY_TIMEOUT = 10000;
const unsigned long SOUND_COOLDOWN = 1500;
const unsigned long DEBOUNCE_TIME = 40;
const unsigned long STARTUP_TIME = 1000;
const unsigned long COLOR_INTERVAL = 500;

// ==================================================
// MELODY 1: BMP180
// Triggered by the sound sensor.
// Durations are denominators: 8 means 1000 / 8 ms.
// ==================================================

